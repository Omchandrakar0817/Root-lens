{
  "version": "1",
  "services": [
    {
      "name": "incident-rca-api",
      "source": "backend",
      "build": {
        "buildCommand": "pip install -r requirements.txt"
      },
      "deploy": {
        "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT",
        "healthcheckPath": "/health"
      }
    },
    {
      "name": "incident-rca-worker",
      "source": "backend",
      "build": {
        "buildCommand": "pip install -r requirements.txt"
      },
      "deploy": {
        "startCommand": "celery -A app.workers.celery_app worker --loglevel=info --concurrency=1"
      }
    },
    {
      "name": "incident-rca-beat",
      "source": "backend",
      "build": {
        "buildCommand": "pip install -r requirements.txt"
      },
      "deploy": {
        "startCommand": "celery -A app.workers.celery_app beat --loglevel=info"
      }
    }
  ]
}
