APP_ENV=development
APP_NAME=Incident RCA
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/incident_rca
JWT_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=7

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PAGESPEED_API_KEY=

MAX_WEBSITES_PER_USER=10
MIN_MONITOR_INTERVAL_SECONDS=300
SCAN_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=1000000
MAX_SCANS_PER_HOUR=12
ANOMALY_MIN_SAMPLES=30
WORKER_CONCURRENCY_HINT=2
ADMIN_EMAIL=
ADMIN_PASSWORD=
