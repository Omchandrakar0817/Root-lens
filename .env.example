# Copy to backend/.env for local API development.
# Never commit real secrets.

APP_ENV=development
APP_NAME=Incident RCA
API_V1_PREFIX=/api/v1
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (Supabase in production, local Postgres in development).
# Example Supabase pooler URL:
# postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/incident_rca

# JWT. Generate long random strings for production.
JWT_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=7

# Redis / Celery. Scheduled monitoring requires a real Redis service.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Optional Google APIs. The app works without them and uses rule-based fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
PAGESPEED_API_KEY=

# Limits
MAX_WEBSITES_PER_USER=10
MIN_MONITOR_INTERVAL_SECONDS=300
SCAN_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=1000000
MAX_SCANS_PER_HOUR=12
ANOMALY_MIN_SAMPLES=30

# Optional first admin (created only when you run the seed command).
ADMIN_EMAIL=
ADMIN_PASSWORD=
